@model RecipeListViewModel
@{ ViewData["Title"] = "Món ăn"; }
<link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
<div class="container page-head"><div><span class="eyebrow">Kho công thức</span><h1>Tìm món ngon cho hôm nay</h1><p>Khám phá các món Việt quen thuộc, dễ nấu và được hướng dẫn từng bước.</p></div><a class="btn btn-primary" asp-action="Random">🎲 Chọn món ngẫu nhiên</a></div>
<section class="container recipe-toolbar"><form method="get" asp-action="Index" class="search-form"><label class="sr-only" for="search">Tìm kiếm</label><input id="search" name="search" value="@Model.SearchKeyword" placeholder="🔍 Bạn muốn ăn gì?" /><button class="btn btn-primary" type="submit">Tìm kiếm</button></form><div class="category-pills"><a class="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")" asp-action="Index">Tất cả</a>@foreach(var c in Model.Categories){<a class="@(Model.SelectedCategory == c.Name ? "active" : "")" asp-action="Index" asp-route-category="@c.Name" asp-route-search="@Model.SearchKeyword">@c.Name</a>}</div></section>
<section class="container"><div class="result-bar"><strong>@Model.Recipes.Count() món ăn</strong>@if(!string.IsNullOrWhiteSpace(Model.SearchKeyword)){<span>cho “@Model.SearchKeyword”</span>}</div>@if(!Model.Recipes.Any()){<div class="empty-state"><div>🍽️</div><h2>Chưa tìm thấy món phù hợp</h2><p>Thử từ khóa khác hoặc bỏ bộ lọc.</p><a class="btn btn-secondary" asp-action="Index">Xóa bộ lọc</a></div>}else{<div class="recipe-grid">@foreach(var recipe in Model.Recipes){<partial name="_RecipeCard" model="recipe" />}</div>}</section>
