@model Recipe?
@{ ViewData["Title"] = "Ăn gì hôm nay?"; }
<link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
<div class="random-page"><div class="container random-wrap"><span class="pill">🎲 Trợ lý chọn món</span><h1>Hôm nay <em>ăn gì?</em></h1><p class="random-subtitle">Không cần đắn đo. Bếp Nhà Mình chọn giúp bạn.</p><div id="randomLoader" class="random-loader"><div class="loader-plate">🍲</div><p>Đang chọn một món thật ngon...</p></div>@if(Model is not null){<div id="randomResult" class="random-result"><div class="random-image"><img src="@Model.ImageUrl" alt="@Model.Name" /></div><div class="random-copy"><span class="eyebrow">🎉 Hôm nay ăn:</span><h2>@Model.Name</h2><p>@Model.Description</p><div class="meta-row big"><span>⏱ @(Model.PreparationTime + Model.CookingTime) phút</span><span>👥 @Model.Servings người</span><span>⭐ @Model.Difficulty</span></div><div class="hero-actions"><a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.Id">Xem công thức</a><a class="btn btn-secondary" asp-action="Random">🎲 Chọn lại</a></div></div></div>}</div></div>
@section Scripts { <script src="~/js/recipe.js" asp-append-version="true"></script> }
