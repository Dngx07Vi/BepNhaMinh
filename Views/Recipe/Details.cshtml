@model RecipeDetailViewModel
@{ ViewData["Title"] = Model.Recipe.Name; }
<link rel="stylesheet" href="~/css/recipe.css" asp-append-version="true" />
<meta name="description" content="@Model.Recipe.Description" />
<div class="container detail-page"><a class="back-link" asp-action="Index">← Quay lại danh sách</a><section class="detail-hero"><div class="detail-image"><img src="@Model.Recipe.ImageUrl" alt="@Model.Recipe.Name" /></div><div class="detail-summary"><span class="eyebrow">@Model.Recipe.Category?.Name</span><h1>@Model.Recipe.Name</h1><p class="lead">@Model.Recipe.Description</p><div class="detail-meta"><div><span>⏱</span><strong>@Model.Recipe.PreparationTime phút</strong><small>Chuẩn bị</small></div><div><span>🔥</span><strong>@Model.Recipe.CookingTime phút</strong><small>Nấu</small></div><div><span>👥</span><strong>@Model.Recipe.Servings người</strong><small>Khẩu phần</small></div><div><span>⭐</span><strong>@Model.Recipe.Difficulty</strong><small>Độ khó</small></div></div><form asp-action="ToggleFavorite" method="post" class="favorite-detail-form"><input type="hidden" name="id" value="@Model.Recipe.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button class="btn @(Model.IsFavorite ? "btn-favorite active" : "btn-secondary")" type="submit">@(Model.IsFavorite ? "♥ Đã yêu thích" : "♡ Yêu thích")</button></form></div></section>
<div class="detail-columns"><article><section class="recipe-section"><h2>Nguyên liệu</h2><div class="ingredient-list">@foreach(var item in Model.Ingredients){<label><input type="checkbox" /> <span>@item.Ingredient?.Name</span><strong>@item.Quantity</strong></label>}</div></section><section class="recipe-section"><h2>Cách chế biến</h2><div class="steps">@foreach(var step in Model.CookingSteps){<div class="step"><div class="step-number">@step.StepNumber</div><div><h3>@step.Title</h3><p>@step.Description</p></div></div>}</div></section><section class="tip-box"><div>💡</div><div><h2>Mẹo nấu ăn</h2><p>Chuẩn bị nguyên liệu trước khi bật bếp giúp thao tác nhanh hơn. Nêm gia vị từng chút một và nếm lại trước khi tắt bếp.</p></div></section></article><aside class="detail-aside"><div class="nutrition-card"><span class="eyebrow">Thông tin</span><h3>Dinh dưỡng ước tính</h3><strong>@Model.Recipe.Calories kcal</strong><p>mỗi khẩu phần</p></div></aside></div>
<section class="related-section"><div class="section-heading"><div><span class="eyebrow">Khám phá thêm</span><h2>Món ăn có thể bạn thích</h2></div></div><div class="recipe-grid">@foreach(var recipe in Model.RelatedRecipes){<partial name="_RecipeCard" model="recipe" />}</div></section></div>
