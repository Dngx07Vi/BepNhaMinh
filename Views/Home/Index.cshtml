@model HomeViewModel
@{ ViewData["Title"] = "Trang chủ"; }
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<section class="hero-section"><div class="container hero-content"><div class="hero-copy"><span class="pill">🥢 Ẩm thực Việt · Gợi ý thông minh</span><h1>Hôm nay <em>ăn gì?</em></h1><p>Không cần suy nghĩ. Để Bếp Nhà Mình chọn món cho bạn.</p><div class="hero-actions"><a class="btn btn-primary btn-large" asp-controller="Recipe" asp-action="Random">🎲 Ăn gì hôm nay?</a><a class="btn btn-secondary btn-large" asp-controller="Recipe" asp-action="Index">Xem tất cả món ăn</a></div></div><div class="hero-art"><div class="hero-orbit">🍜</div><div class="hero-card hero-card-one">🍲<strong>Món ngon</strong><small>20+ công thức</small></div><div class="hero-card hero-card-two">❤️<strong>Yêu thích</strong><small>Lưu món dễ dàng</small></div></div></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">Được chọn cho bạn</span><h2>Món nổi bật</h2></div><a class="text-link" asp-controller="Recipe" asp-action="Index">Xem tất cả →</a></div><div class="recipe-grid">@foreach(var recipe in Model.FeaturedRecipes){<partial name="_RecipeCard" model="recipe" />}</div></section>
<section class="section categories-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Khám phá</span><h2>Chọn theo khẩu vị</h2></div></div><div class="category-grid">@foreach(var category in Model.Categories){<partial name="_CategoryCard" model="category" />}</div></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">Thử ngay</span><h2>Gợi ý cho bữa ăn</h2></div></div><div class="recipe-grid">@foreach(var recipe in Model.PopularRecipes.Take(8)){<partial name="_RecipeCard" model="recipe" />}</div></section>
